# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Required ---------------------------------------------------------------
API_KEY=your_financialmodelingprep_api_key
host=localhost
port=5432
database=your_database
user=your_db_user
password=your_db_password

# --- Optional: database -----------------------------------------------------
# disable | prefer | require
sslmode=disable

# --- Optional: universe -----------------------------------------------------
# Symbols per run. Screener returns ~5900 actively-traded equities.
MAX_SYMBOLS=250
# Symbols fetched, transformed and committed as one restartable unit.
SYMBOL_CHUNK=100

# --- Optional: API ----------------------------------------------------------
# Your plan's rate limit.
FMP_CALLS_PER_MINUTE=300
# Back-to-back requests before throttling. Blank = full per-minute allowance.
# Lower this (e.g. 60) if you see 429s on the opening burst.
FMP_BURST=
FMP_CONCURRENCY=20
FMP_TIMEOUT=30
FMP_MAX_RETRIES=4

# --- Optional: EOD job ------------------------------------------------------
# Lookback window when a symbol has no history yet.
EOD_LOOKBACK_DAYS=5
# Watermarks older than this are treated as delisted and excluded from the
# incremental window, so one stale ticker cannot widen the fetch for everyone.
EOD_STALE_AFTER_DAYS=30

# --- Optional: caching ------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# --- Optional: behaviour ----------------------------------------------------
# Populate the four recoverable NULL columns (interest_coverage, ebit_growth,
# eps_growth, shares_outstanding). No schema change required.
# See ARCHITECTURE.md -> "Known-NULL columns".
CORRECTED_FIELDS=0

LOG_LEVEL=INFO
